{
  "name": "XML",
  "scopeName": "text.xml",
  "fileTypes": ["xml", "html", "htm", "xhtml", "svg"],
  "patterns": [
    {
      "name": "comment.block.xml",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "name": "meta.tag.xml",
      "begin": "<[a-zA-Z0-9_:.-]+",
      "end": "/?>",
      "patterns": [
        {
          "name": "string.quoted.double.xml",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.xml",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "entity.other.attribute-name.xml",
          "match": "\\b[a-zA-Z0-9_:-]+(?=\\=)"
        }
      ]
    },
    {
      "name": "meta.tag.end.xml",
      "match": "</[a-zA-Z0-9_:.-]+>"
    },
    {
      "name": "constant.character.entity.xml",
      "match": "&[a-zA-Z0-9#]+;"
    }
  ]
}