{
  "name": "gradle",
  "scopeName": "source.gradle",
  "fileTypes": ["gradle", "gradle.kts"],
  "patterns": [
    {
      "name": "comment.line.double-slash.gradle",
      "match": "//.*$"
    },
    {
      "name": "comment.block.gradle",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.gradle",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.gradle",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.gradle",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.gradle",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.gradle",
      "match": "\\b(plugins|dependencies|android|buildTypes|productFlavors|ext|configurations|repositories|allprojects|subprojects|repositories|task|apply|if|else|for|while|def|classpath|implementation|testImplementation|debugImplementation|releaseImplementation|api|compileOnly|runtimeOnly)\\b"
    },
    {
      "name": "support.function.gradle",
      "match": "\\b(id|version|group|archivesBaseName|sourceCompatibility|targetCompatibility|compileSdkVersion|minSdkVersion|targetSdkVersion|versionCode|versionName|testInstrumentationRunner|multiDexEnabled)\\b"
    },
    {
      "name": "constant.numeric.gradle",
      "match": "\\b([0-9]+|0x[0-9a-fA-F]+|[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?[fFdD]?)\\b"
    },
    {
      "name": "entity.name.function.gradle",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    {
      "name": "constant.language.gradle",
      "match": "\\b(true|false|null)\\b"
    }
  ]
}