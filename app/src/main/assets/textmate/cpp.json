{
  "name": "C++",
  "scopeName": "source.cpp",
  "fileTypes": ["c", "cpp", "h", "hpp", "cc", "cxx"],
  "patterns": [
    {
      "name": "comment.line.double-slash.cpp",
      "match": "//.*$"
    },
    {
      "name": "comment.block.cpp",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.cpp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cpp",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.directive.cpp",
      "match": "^\\s*#\\s*(include|define|ifndef|endif|pragma|if|else|elif|ifdef)\\b"
    },
    {
      "name": "keyword.control.cpp",
      "match": "\\b(if|else|for|while|do|return|break|continue|switch|case|try|catch|new|delete)\\b"
    },
    {
      "name": "storage.type.cpp",
      "match": "\\b(int|float|double|char|void|bool|auto|class|struct|enum|union|namespace|const|static|public|private|protected)\\b"
    },
    {
      "name": "constant.numeric.cpp",
      "match": "\\b(\\d+|0x[0-9a-fA-F]+|\\d+\\.\\d+f?)\\b"
    }
  ]
}