{
  "name": "XML",
  "scopeName": "text.xml",
  "fileTypes": ["xml", "html", "htm", "xhtml", "svg"],
  "patterns": [
    {
      "name": "comment.block.xml",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "name": "meta.tag.preprocessor.xml",
      "begin": "(<\\?)(xml)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.xml" },
        "2": { "name": "entity.name.tag.xml" }
      },
      "end": "(\\?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.xml" }
      },
      "patterns": [
        {
          "include": "#tag-attributes"
        }
      ]
    },
    {
      "name": "meta.tag.xml",
      "begin": "(<)([a-zA-Z0-9_.:-]+)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.xml" },
        "2": { "name": "entity.name.tag.xml" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.xml" }
      },
      "patterns": [
        {
          "include": "#tag-attributes"
        }
      ]
    },
    {
      "name": "meta.tag.end.xml",
      "match": "(</)([a-zA-Z0-9_.:-]+)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.xml" },
        "2": { "name": "entity.name.tag.xml" },
        "3": { "name": "punctuation.definition.tag.xml" }
      }
    },
    {
      "name": "string.unquoted.cdata.xml",
      "begin": "<!\\[CDATA\\[",
      "end": "\\]\\]>"
    },
    {
      "name": "constant.character.entity.xml",
      "match": "&([a-zA-Z0-9]+|#[0-9]+|#x[0-9a-fA-F]+);"
    }
  ],
  "repository": {
    "tag-attributes": {
      "patterns": [
        {
          "name": "string.quoted.double.xml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.xml",
              "match": "\\\\."
            },
            {
              "name": "constant.character.entity.xml",
              "match": "&([a-zA-Z0-9]+|#[0-9]+|#x[0-9a-fA-F]+);"
            }
          ]
        },
        {
          "name": "string.quoted.single.xml",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.xml",
              "match": "\\\\."
            },
            {
              "name": "constant.character.entity.xml",
              "match": "&([a-zA-Z0-9]+|#[0-9]+|#x[0-9a-fA-F]+);"
            }
          ]
        },
        {
          "match": "([a-zA-Z0-9_]+):([a-zA-Z0-9_.:-]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.namespace.xml" },
            "2": { "name": "entity.other.attribute-name.xml" }
          }
        },
        {
          "match": "\\b([a-zA-Z0-9_.:-]+)(?=\\s*=)",
          "name": "entity.other.attribute-name.xml"
        },
        {
          "name": "keyword.operator.xml",
          "match": "="
        }
      ]
    }
  }
}