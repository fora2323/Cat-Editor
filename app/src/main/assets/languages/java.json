{
  "name": "java",
  "scopeName": "source.java",
  "fileTypes": ["java"],
  "patterns": [
    {
      "name": "comment.line.double-slash.java",
      "match": "//.*$"
    },
    {
      "name": "comment.block.java",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.java",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.java",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.java",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.java",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.java",
      "match": "\\b(if|else|switch|case|default|for|while|do|try|catch|finally|throw|return|break|continue|new|instanceof|extends|implements|interface|class|enum|abstract|final|static|public|private|protected|package|import|native|synchronized|volatile|transient|strictfp)\\b"
    },
    {
      "name": "keyword.reserved.java",
      "match": "\\b(void|boolean|byte|char|short|int|long|float|double|const|goto)\\b"
    },
    {
      "name": "constant.numeric.java",
      "match": "\\b([0-9]+|0x[0-9a-fA-F]+|0b[01]+|[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?[fFdD]?)\\b"
    },
    {
      "name": "entity.name.function.java",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    {
      "name": "entity.name.class.java",
      "match": "\\b(class|interface|enum)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
    },
    {
      "name": "constant.language.java",
      "match": "\\b(true|false|null)\\b"
    }
  ]
}